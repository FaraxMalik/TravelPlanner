# =====================================================
# IMPORTANT: What TO KEEP in Git
# =====================================================
# Keep these important files:
# ✅ package.json (all locations)
# ✅ requirements.txt
# ✅ README.md files
# ✅ Source code (.js, .jsx, .py files)
# ✅ Config files (database.js, etc.)
# ✅ Small JSON config files
# ✅ Documentation (.md files)

# Explicitly include important config files
!package.json
!requirements.txt
!README.md
!*.md
!config/*.js
!new_travel_questions.json

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

